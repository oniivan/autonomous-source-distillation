{"schema_version": 3, "chunk_id": "S1-R1-C001", "source_id": "S1", "source_revision_id": "S1-R1", "ordinal": 1, "boundary_mode": "line", "source_sha256": "055c3620358ba71a6b54342500463b95f9cf6bb6bdfacceda8400da296c1a4c1", "source_line_count": 1, "line_start": 1, "line_end": 1, "content_line_start": 1, "content_line_end": 1, "overlap_line_start": null, "overlap_line_end": null, "overlap_line_count": 0, "locator_start": null, "locator_end": null, "content_locator_start": null, "content_locator_end": null, "word_count": 21, "content_word_count": 21, "chunk_sha256": "9fa97ead35ba71bb5fb0b232c0bd43f7777f3865cc6c77b36d090f9da29bdda9", "content_sha256": "9fa97ead35ba71bb5fb0b232c0bd43f7777f3865cc6c77b36d090f9da29bdda9", "text": "Regional pilot leads concluded that an October rollout was ready for the United States and Canada. They did not assess Europe."}
